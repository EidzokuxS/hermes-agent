{
  "name": "nox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build:renderer --workspace @nox/desktop",
    "check:kill-criteria": "node scripts/check-kill-criteria.mjs",
    "evidence:first-loop": "node scripts/build-evidence.mjs",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint .",
    "node:check": "node scripts/check-node-version.mjs",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "test:desktop-integration": "vitest run --config vitest.config.ts tests/e2e --passWithNoTests",
    "test:foundation": "vitest run --config vitest.config.ts tests/integration --passWithNoTests",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:first-loop": "node scripts/verify-evidence.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.59.1",
    "@typescript-eslint/parser": "8.59.1",
    "@vitejs/plugin-react": "6.0.1",
    "electron": "40.10.2",
    "eslint": "9.39.4",
    "eslint-plugin-perfectionist": "5.9.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "16.5.0",
    "jsdom": "29.1.1",
    "playwright": "1.61.1",
    "prettier": "3.8.3",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.5"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "electron@40.10.2": true,
    "esbuild@0.28.1": true,
    "protobufjs@7.6.5": true
  }
}
